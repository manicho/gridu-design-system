# Logs
logs
*.log

# Dependencies
node_modules
.pnp
.pnp.js

# Build output
# dist/ IS committed (not ignored) — git-dependency installs (gridu-web, gridu-landing) need
# the built output without running this repo's own devDependencies (Vite, Tailwind v4, and
# its native lightningcss binaries), which `prepare` previously pulled in and pushed Yarn
# classic into a known extraction-corruption bug under that load (see consumer commits).
dist-ssr
*.local

# Env files (never commit secrets)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store

# Claude Code local credentials (skills/settings are tracked, this is not)
.claude/settings.local.json
